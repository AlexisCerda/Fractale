<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="figure.Controler.Vue">
    <SplitPane dividerPositions="0.25000000000000006" focusTraversable="true"
               VBox.vgrow="ALWAYS">
        <AnchorPane fx:id="PaneButton" minWidth="200.0" prefHeight="591.0" prefWidth="217.0">
            <Button fx:id="plus" layoutX="111.0" layoutY="93.0" mnemonicParsing="false" text="+"/>
            <Button fx:id="moins" layoutX="61.0" layoutY="93.0" mnemonicParsing="false" text="-"/>
            <Label fx:id="Nbr_iteration" contentDisplay="CENTER" layoutX="88.0" layoutY="94.0" prefHeight="23.0"
                   prefWidth="25.0" text="1" textAlignment="CENTER" wrapText="true"/>
            <TextField layoutX="57.0" layoutY="187.0" prefHeight="25.0" prefWidth="84.0" text="1000" fx:id="nbr_taille"/>
            <Label layoutX="64.0" layoutY="161.0" text="Taille fractale"/>
            <MenuButton fx:id="Menu_fractale" layoutX="62.0" layoutY="230.0" maxHeight="-Infinity"
                        maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false"
                        text="Fractale">
            </MenuButton>
            <Button fx:id="actualiser" layoutX="67.0" layoutY="127.0" mnemonicParsing="false" text="Actualiser"/>
            <Label layoutX="21.0" layoutY="287.0" text="Nombre d'entités : " fx:id="Nbr_Entite"/>
        </AnchorPane>
        <ScrollPane>
            <AnchorPane id="Content" fx:id="view_fractal" prefHeight="589.0"
                        prefWidth="667.0"/>
        </ScrollPane>
    </SplitPane>
    <HBox id="HBox" alignment="CENTER_LEFT" spacing="5.0" VBox.vgrow="NEVER">
        <padding>
            <Insets bottom="3.0" left="3.0" right="3.0" top="3.0"/>
        </padding>
    </HBox>
</VBox>
